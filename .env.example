# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection (Cloud SQL / PostgreSQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Initial Administrator Provisioning (Optional)
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_INITIAL_NAME="System Administrator"

# SMTP Email Configuration (Optional - for real email delivery & newsletter broadcasting)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@chillyads.com"

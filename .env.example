# Application URL & Server Port
# REQUIRED in production. Must be the full URL (e.g., https://chillyads.com) without a trailing slash.
APP_URL="http://localhost:3000"
PORT="3000"
TRUST_PROXY="false"

# PostgreSQL Database Connection (Cloud SQL / PostgreSQL)
# SQL_HOST is REQUIRED in production unless ALLOW_PGLITE=true is set (not recommended).
SQL_HOST=""
SQL_PORT="5432"
# SQL_DB_NAME, SQL_USER, and SQL_PASSWORD are REQUIRED in production when SQL_HOST is provided.
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
SQL_SSL="false"
ALLOW_PGLITE="false"

# Initial Administrator Provisioning (Optional)
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_INITIAL_NAME="System Administrator"

# Payment Gateway Configuration (Posting Fees & Boost Monetization)
PAYMENT_GATEWAY_PROVIDER="razorpay"
PAYMENT_GATEWAY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# SMTP Email Configuration (Transactional Emails & Newsletter Broadcasting)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@chillyads.com"

# Google Maps Platform (Client-Side Location Autocomplete & Map Picker)
VITE_GOOGLE_MAPS_API_KEY=""

# Media & File Storage Configuration (Local or S3-Compatible Object Storage)
STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

